{
  "compilerOptions": {
    "target": "ES2024",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "baseUrl": ".",
    "paths": {
      "@/*": ["apps/renderer/src/*"],
      "@browser/shared": ["packages/shared/src/index.ts"],
      "@browser/ipc-contract": ["packages/ipc-contract/src/index.ts"],
      "@browser/proxy": ["packages/proxy/src/index.ts"],
      "@wmfx/database": ["packages/database/src/index.ts"]
    },
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": true,
    "sourceMap": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true
  }
}
